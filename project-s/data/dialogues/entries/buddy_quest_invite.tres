[ext_resource type="Script" uid="uid://dd4prp8dknc2h" path="res://scripts/resources/dialogue_entry.gd" id="1_entry"]
[ext_resource type="Script" uid="uid://d0187gqcfnk8" path="res://scripts/resources/dialogue_condition.gd" id="2_cond"]
[ext_resource type="Resource" uid="uid://ct3k711f0y11s" path="res://data/dialogues/buddy_quest_invite.tres" id="3_dialogue"]

[sub_resource type="Resource" id="cond_met_buddy"]
