[sub_resource type="Resource" id="line_buddy_explain"]
script = ExtResource("2_line")
speaker = "Buddy"
text = "This is our research facility. We've been working on something incredible with crystal energy."
next_id = "buddy_intro_end"

[sub_resource type="Resource" id="line_buddy_intro_end"]
script = ExtResource("2_line")
speaker = "Buddy"
text = "Feel free to look around. Let me know if you want to help with our research!"

[sub_resource type="Resource" id="line_player_response"]
script = ExtResource("2_line")
speaker = "You"
text = "I'm doing alright. What is this place?"
next_id = "buddy_explain"

[sub_resource type="Resource" id="line_start"]
script = ExtResource("2_line")
speaker = "Buddy"
text = "Hey there! Welcome to the lab. How are you feeling?"
next_id = "player_response"

